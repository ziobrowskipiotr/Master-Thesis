# Terraform — pobrane wtyczki (providerzy) i stan lokalny
infra/**/.terraform/
infra/**/terraform.tfstate
infra/**/terraform.tfstate.backup
infra/**/.terraform.lock.hcl
# Klucze SSH generowane przez Terraform
infra/**/*.pem
infra/**/*_rsa
infra/**/*_ed25519

# Build artifacts
build/
bin/

# QEMU VM disk images and cloud-init seeds
scripts/vm/vm_data/
*.qcow2
*.iso
*.img

# Python cache and datasets
__pycache__/
*.pyc
*.bin
*.sha256
*.csv
*.png
benchmark_*.json
zadanie.md
*.pdf
*.html
